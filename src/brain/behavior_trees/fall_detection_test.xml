<root BTCPP_format="4">
    <include path="./subtrees/subtree_periodic_fall_recovery.xml" />
    
    <BehaviorTree ID="MainTree">
        <Sequence name="root">
            <RunOnce> <Script code="treat_person_as_robot:=false" /> </RunOnce>

            <!-- CONTINUOUS FALL DETECTION DEMO -->
            <ReactiveSequence name="fall_detection_demo">
                <PrintMsg msg="Starting periodic fall detection system..." />
                
                <!-- Enhanced periodic fall detection with custom settings -->
                <CheckAndStandUpPeriodic 
                    check_interval_ms="100" 
                    standup_timeout_ms="10000" 
                    auto_relocate_after_standup="true" 
                    force_relocate_always="false" />
                
                <!-- Relocalization sequence -->
                <ReactiveSequence _while="should_recalibrate_after_fall_recovery">
                    <PrintMsg msg="Fall detected! Executing enhanced relocalization..." />
                    <SelfLocate mode="fall_recovery" />
                    <RotateForRelocate vyaw_limit="1.0" max_msec_locate="10000" />
                    <PrintMsg msg="Relocalization completed!" />
                </ReactiveSequence>
                
                <!-- Basic robot behaviors when not fallen -->
                <ReactiveSequence _while="control_state==3" name="normal_operation">
                    <PrintMsg msg="Robot is operational and monitoring for falls..." />
                    <SetVelocity x="0" y="0" theta="0" />
                </ReactiveSequence>
            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>
</root> 