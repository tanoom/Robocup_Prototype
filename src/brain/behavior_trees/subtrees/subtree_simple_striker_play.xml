<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <BehaviorTree ID="SimpleStrikerPlay">
      <ReactiveSequence>
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="start">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <ReactiveSequence>
               <GoBackInField valve="0.5" />
               <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.2" kick_range_threshold="1.5" dribble_range_threshold="1.0" />
               <SubTree ID="FindBall" _while="decision=='find'" _autoremap="true" />
            </ReactiveSequence>
            <IfThenElse>
               <ScriptCondition name="Robot in opponent half?" code="robot_pose_x > 0.0" />
               <Sequence name="robot_in_opponent_half">
                  <!-- <PrintMsg msg="Robot in opponent half, executing full striker logic" /> -->
                  <ReactiveSequence>
                     <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.2" kick_range_threshold="1.0" dribble_range_threshold="0.8" />
                     <SubTree ID="FindBall" _while="decision=='find'" _autoremap="true" />
                  </ReactiveSequence>
                  <Chase   _while="decision == 'chase'"  vx_limit="1.0"  vy_limit="0.4"  vtheta_limit="1.0"  dist="1.0"/>
                  <ChaseToTarget _while="decision == 'chasetotarget'" 
                                 vx_limit="0.8" 
                                 vy_limit="0.3" 
                                 vtheta_limit="0.8" 
                                 dist="0.4" 
                                 target_x="6.5" 
                                 target_y="0.0" 
                                 turn_factor="0.6"
                                 enable_dribbling="true"
                                 dribble_distance="0.3"
                                 dribble_kick_power="0.4"
                                 dribble_kick_duration="250"
                                 dribble_cooldown="600" />
                  <Adjust _while="decision == 'adjust'" turn_threshold="0.5" range="0.5" vx_limit="0.5" vy_limit="0.6" vtheta_limit="1.5" vtheta_factor="4.5" tangential_speed_far="0.9" tangential_speed_near="0.4" />
                  <Sequence  _while="decision == 'kick'">
                     <SetVelocity />
                     <Sleep msec="1000" />
                     <Kick vx_limit="1.2" vy_limit="0.4" min_msec_kick="1000"/>
                  </Sequence>
               </Sequence>
               <Sequence name="robot_in_our_half">
                  <!-- <PrintMsg msg="Robot in our half, only chasing to target with closer distance" /> -->
                  <ChaseToTarget
                     vx_limit="1.0" 
                     vy_limit="1.0" 
                     vtheta_limit="1.0" 
                     dist="0.3"
                     target_x="7.0"
                     target_y="0.0" 
                     turn_factor="1.0"
                     enable_dribbling="true"
                     dribble_distance="0.2"
                     dribble_kick_power="0.7"
                     dribble_kick_duration="300"
                     dribble_cooldown="1000"
                  />
               </Sequence>
            </IfThenElse>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root> 