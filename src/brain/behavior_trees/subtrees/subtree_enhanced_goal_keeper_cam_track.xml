<root BTCPP_format="4" >
   <BehaviorTree ID="EnhancedGoalKeeperCamTrack">
      <Sequence name="root">
         <RunOnce>
            <PrintMsg msg="Starting Enhanced Goal Keeper Camera Tracking" />
         </RunOnce>
         
         <ReactiveSequence name="enhanced_tracking">
            <!-- Try normal head tracking first -->
            <IfThenElse>
               <ScriptCondition name="Can track ball with head?" code="ball_location_known" />
               <Sequence name="normal_head_tracking">
                  <!-- <PrintMsg msg="Ball detected, using normal head tracking" /> -->
                  <CamTrackBall />
               </Sequence>
               <Sequence name="enhanced_search_with_body_turn">
                  <PrintMsg msg="Ball not detected, starting enhanced search" />
                  
                  <!-- Enhanced ball search with body turning capability -->
                  <ReactiveSequence name="search_with_turn_capability">
                     <!-- Phase 1: Try normal head search first -->
                                                                <IfThenElse>
                        <ScriptCondition name="Is robot facing forward?" code="is_facing_forward" />
                        <Sequence name="search_forward_facing">
                           <PrintMsg msg="Robot facing forward (90°), searching with head movements" />
                           <CamFindBall />
                           
                           <!-- If still no ball after head search, consider ball might be behind -->
                           <IfThenElse>
                              <ScriptCondition name="Still no ball after head search?" code="!ball_location_known" />
                              <Sequence name="turn_to_search_behind">
                                 <PrintMsg msg="Ball not found in front, turning 180° to search behind" />
                                 <TurnByAngle rad="-3.14" />
                                 <SetVelocity x="0" y="0" theta="0" />
                                 <PrintMsg msg="Completed 180° turn, now facing -90°" />
                                 <Sleep msec="500" />
                              </Sequence>
                              <PrintMsg msg="Ball found during forward search" />
                           </IfThenElse>
                        </Sequence>
                        <Sequence name="search_backward_facing">
                           <PrintMsg msg="Robot facing backward (-90°), searching with head movements" />
                           <CamFindBall />
                           
                           <!-- If still no ball after head search, turn back to forward -->
                           <IfThenElse>
                              <ScriptCondition name="Still no ball after backward search?" code="!ball_location_known" />
                              <Sequence name="turn_to_search_forward">
                                 <PrintMsg msg="Ball not found behind, turning 180° to search forward" />
                                 <TurnByAngle rad="3.14" />
                                 <SetVelocity x="0" y="0" theta="0" />
                                 <PrintMsg msg="Completed 180° turn, now facing 90°" />
                                 <Sleep msec="500" />
                              </Sequence>
                              <PrintMsg msg="Ball found during backward search" />
                           </IfThenElse>
                        </Sequence>
                     </IfThenElse>
                  </ReactiveSequence>
               </Sequence>
            </IfThenElse>
         </ReactiveSequence>
         
         <PrintMsg msg="Enhanced Goal Keeper Camera Tracking completed" />
      </Sequence>
   </BehaviorTree>
</root> 