<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <BehaviorTree ID="StrikerPlay">
      <ReactiveSequence>
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="start">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <CalcKickDir />
            <Sequence>
                  <ReactiveSequence>
                     <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.2" kick_range_threshold="1.0" dribble_range_threshold="0.8" />
                     <SubTree ID="FindBall" _while="decision=='find'" _autoremap="true" />
                  </ReactiveSequence>
                  <Chase   _while="decision == 'chase'"  vx_limit="1.0"  vy_limit="0.4"  vtheta_limit="1.0"  dist="1.0" safe_dist="0.5"/>
                  <ChaseToTarget _while="decision == 'chasetotarget'" 
                                 vx_limit="1.0" 
                                 vy_limit="0.4" 
                                 vtheta_limit="1.0" 
                                 dist="0.2" 
                                 target_x="6.5" 
                                 target_y="0.0" 
                                 turn_factor="0.6"
                                 enable_dribbling="true"
                                 dribble_distance="0.3"
                                 dribble_kick_power="1.0"
                                 dribble_kick_duration="250"
                                 dribble_cooldown="1000" />
                  <Adjust  _while="decision == 'adjust'"  turn_threshold="0.5" range="0.5" vx_limit="0.5" vy_limit="0.6" vtheta_limit="1.5" vtheta_factor="4.5" tangential_speed_far="0.9" tangential_speed_near="0.4"  />
                  <Kick speed_limit="0.8" min_msec_kick="1000" msecs_stablize="1000"/>
            </Sequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
