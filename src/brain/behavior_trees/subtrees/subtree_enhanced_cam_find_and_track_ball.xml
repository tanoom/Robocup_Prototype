<root BTCPP_format="4" >
  <include path="./subtree_cam_find_and_track_ball.xml" />
  
  <BehaviorTree ID="EnhancedCamFindAndTrackBall">
     <Sequence name="root">
         <RunOnce>
             <PrintMsg msg="Starting Enhanced Camera Find and Track Ball behavior tree" />
         </RunOnce>
         
         <IfThenElse>
             <ScriptCondition name="Do we known the location of the ball?" code="ball_location_known" />
             <Sequence name="[Yes] -> track the ball" >
                <PrintMsg msg="Ball location is known, starting ball tracking" />
                <CamTrackBall />
                <PrintMsg msg="Ball tracking completed" />
             </Sequence>
             <Sequence name="[No] -> enhanced ball finding with teammate collaboration">
                <PrintMsg msg="Ball location is unknown, starting enhanced ball finding strategy" />
                <!-- 增强版找球策略：30秒自己找球 + 队友协作 -->
                <ReactiveSequence name="time_based_ball_search">
                    <!-- 初始化查找开始时间 -->
                    <RunOnce>
                        <Sequence>
                            <SetBlackboard output_key="ball_search_start_time" value="{current_time}" />
                            <PrintMsg msg="Ball search timer initialized, starting independent ball search phase" />
                        </Sequence>
                    </RunOnce>
                    
                    <!-- 策略1：30秒内优先使用原有的找球逻辑 -->
                    <Fallback name="timed_ball_search">
                        <!-- 如果在30秒内，继续使用原有找球逻辑 -->
                        <Sequence name="original_ball_search_with_timeout">
                            <ScriptCondition code="(current_time - ball_search_start_time) < 5.0" />
                            <PrintMsg msg="Within 5 second timeout, executing original ball search algorithm" />
                            <CamFindBall />
                            <PrintMsg msg="Original ball search completed" />
                        </Sequence>
                        
                        <!-- 策略2：30秒后，尝试队友协作 -->
                        <Sequence name="teammate_assisted_search_after_timeout">
                            <PrintMsg msg="Timeout reached, switching to teammate collaboration mode" />
                            <!-- 尝试队友协作找球 -->
                            <Fallback name="teammate_collaboration">
                                <!-- 如果队友能看到球，去队友球的位置 -->
                                <Sequence name="go_to_teammate_ball_position">
                                    <PrintMsg msg="Attempting to go to teammate's ball position" />
                                    <GoToTeammateBall 
                                        long_range_threshold="2.0"
                                        turn_threshold="0.4"
                                        vx_limit="0.8" 
                                        vy_limit="0.5" 
                                        vtheta_limit="1.2" 
                                        x_tolerance="0.6"
                                        y_tolerance="0.6"
                                        theta_tolerance="0.3"
                                    />
                                    <PrintMsg msg="Reached teammate ball position, searching with camera" />
                                    <CamFindBall />
                                    <!-- 只有找到球后才重置计时器 -->
                                    <IfThenElse>
                                        <ScriptCondition code="ball_location_known" />
                                        <Sequence name="ball_found_reset_timer">
                                            <SetBlackboard output_key="ball_search_start_time" value="{current_time}" />
                                            <PrintMsg msg="Ball found! Timer reset, ball search at teammate position completed" />
                                        </Sequence>
                                        <PrintMsg msg="Ball not found at teammate position, keeping original timer" />
                                    </IfThenElse>
                                </Sequence>
                                
                                <!-- 如果队友协作失败，重置计时器继续使用原有找球策略 -->
                                <Sequence name="reset_and_continue_original_search">
                                    <PrintMsg msg="Teammate collaboration failed, resetting timer and continuing with original search" />
                                    <SetBlackboard output_key="ball_search_start_time" value="{current_time}" />
                                    <CamFindBall />
                                    <PrintMsg msg="Fallback ball search completed" />
                                </Sequence>
                            </Fallback>
                        </Sequence>
                    </Fallback>
                </ReactiveSequence>
             </Sequence>
         </IfThenElse>
         
         <PrintMsg msg="Enhanced Camera Find and Track Ball behavior tree completed" />
     </Sequence>
  </BehaviorTree>
</root> 