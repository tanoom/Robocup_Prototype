<root BTCPP_format="4">
    <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />
    <include path="./subtrees/subtree_simple_striker_play.xml" />
    <include path="./subtrees/subtree_goal_keeper_play.xml" />
    <include path="./subtrees/subtree_striker_play.xml" />
    <include path="./subtrees/subtree_striker_freekick.xml" />
    <include path="./subtrees/subtree_goal_keeper_freekick.xml" />
    <include path="./subtrees/subtree_auto_standup_and_locate.xml" />
    <BehaviorTree ID="MainTree">
        <Sequence name="root">
            <RunOnce> <Script code="treat_person_as_robot:=false" /> </RunOnce>

            <ReactiveSequence _while="control_state==2" name="pickup">
                <CamScanField  _while="!odom_calibrated"/>
                <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                <SelfLocate mode="enter_field" />
            </ReactiveSequence>

            <ReactiveSequence _while="control_state==3" name="control_state-3">
                <SubTree ID="AutoGetUpAndLocate" _autoremap="true" />
                <ReactiveSequence _while="gc_is_under_penalty" name="penalty">
                    <SetVelocity />
                    <SelfLocate mode="enter_field" _while="!odom_calibrated" />
                </ReactiveSequence>

                <ReactiveSequence _while="!gc_is_under_penalty" name="normal">
                    <ReactiveSequence _while="gc_game_sub_state_type=='NONE'" name="normal-none">

                        <ReactiveSequence _while="gc_game_state=='INITIAL'" name="init">
                            <CamScanField _while="!odom_calibrated"/>
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                            <SelfLocate mode="enter_field" />
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='READY'" name="ready">
                            <CamScanField />
                            <MoveToPoseOnField x="-2" y="1" _while="player_id == 0" vtheta_limit="2.0"  vx_limit="0.4" />
                            <MoveToPoseOnField x="-2.5" y="-1" _while="player_id == 1" vtheta_limit="2.0"  vx_limit="0.4" />
                            <MoveToPoseOnField x="-6.5" y="0" _while="player_id == 2" vtheta_limit="2.0"  vx_limit="0.4" />
                            <SelfLocate mode="trust_direction" />
                            <!-- <WaveHand _while="we_just_scored" action="start" /> -->
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='SET'" name="set">
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                            <SetVelocity />
                            <!-- <WaveHand action="stop" /> -->
                        </ReactiveSequence>

                        <!-- 协作逻辑的核心部分：在PLAY状态下根据动态角色分配执行不同策略 -->
                        <ReactiveSequence _while="gc_game_state=='PLAY'" name="play">
                            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
                            <!-- <PrintMsg msg="[TREE] Current role: {dynamic_role}" /> -->

                            <!-- 动态角色为守门员的机器人始终执行守门策略 -->
                            <ReactiveSequence _while="is_dynamic_goal_keeper" name="dynamic_goalkeeper_play">
                                <!-- <PrintMsg msg="[TREE] Current role: Goalkeeper (dynamic_role: {dynamic_role})" /> -->
                                <SubTree ID="GoalKeeperPlay" _autoremap="true" />
                            </ReactiveSequence>

                            <!-- 动态角色为主攻击手且拥有球权的机器人执行攻击策略 -->
                            <ReactiveSequence _while="is_dynamic_striker && has_ball_possession" name="striker_with_possession">
                                <!-- <PrintMsg msg="[TREE] Current role: Striker with possession (dynamic_role: {dynamic_role})" /> -->
                                <SubTree ID="StrikerPlay" _autoremap="true" />
                            </ReactiveSequence>

                            <!-- 动态角色为跟随者或主攻击手但没有球权的机器人跟随有球权的机器人 -->
                            <ReactiveSequence _while="is_dynamic_follower" name="follower_play">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <!-- <PrintMsg msg="[TREE] Current role: Follower (dynamic_role: {dynamic_role})" /> -->
                                <!-- <FollowTeammate
                                    follow_distance="1.5"
                                    long_range_threshold="100.0"
                                    turn_threshold="0.3"
                                    vx_limit="1.0"
                                    vy_limit="1.0"
                                    vtheta_limit="1.0"
                                    position_tolerance="0.3"
                                    angle_tolerance="0.2" /> -->
                                <SimpleChase  stop_dist="3.0" stop_angle="0.3" />
                                <!-- <PrintMsg msg="跟随有球权的机器人" /> -->
                            </ReactiveSequence>

                            <!-- 当角色分配未确定时，执行基本球追踪 -->
                            <ReactiveSequence _while="!is_dynamic_striker && !is_dynamic_goal_keeper && !is_dynamic_follower" name="role_unknown">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <!-- <PrintMsg msg="Role not assigned, current dynamic_role: {dynamic_role}" /> -->
                            </ReactiveSequence>
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='END'" name="end">
                            <SetVelocity />
                        </ReactiveSequence>

                    </ReactiveSequence>

                    <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' && gc_game_state=='PLAY'" name="free">
                        <ReactiveSequence _while="gc_game_sub_state=='STOP'">
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                            <SetVelocity />
                        </ReactiveSequence>
                        <ReactiveSequence _while="gc_game_sub_state=='GET_READY'">
                            <!-- 在任意球情况下，根据动态角色分配执行策略 -->
                            <ReactiveSequence _while="is_dynamic_goal_keeper" name="freekick_goalkeeper">
                                <SubTree ID="GoalKeeperFreekick" _autoremap="true"/>
                            </ReactiveSequence>
                            <ReactiveSequence _while="is_dynamic_striker && has_ball_possession" name="freekick_striker_possession">
                                <SubTree ID="StrikerFreekick" _autoremap="true" />
                            </ReactiveSequence>
                            <ReactiveSequence _while="(is_dynamic_follower || (is_dynamic_striker && !has_ball_possession)) && !is_dynamic_goal_keeper" name="freekick_follower">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <FollowTeammate
                                    follow_distance="1.5"
                                    long_range_threshold="6.0"
                                    turn_threshold="0.25"
                                    vx_limit="1.0"
                                    vy_limit="1.0"
                                    vtheta_limit="1.0"
                                    position_tolerance="1.5"
                                    angle_tolerance="1.0" />
                                <!-- <PrintMsg msg="任意球时跟随有球权的机器人" /> -->
                            </ReactiveSequence>
                        </ReactiveSequence>
                        <ReactiveSequence _while="gc_game_sub_state=='SET'">
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                            <SetVelocity />
                        </ReactiveSequence>
                    </ReactiveSequence>

                </ReactiveSequence>

            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>
</root>
