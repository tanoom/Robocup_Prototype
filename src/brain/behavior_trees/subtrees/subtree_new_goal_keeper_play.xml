<root BTCPP_format="4" >
   <BehaviorTree ID="NewGoalKeeperPlay">
      <ReactiveSequence >
         <!-- 等待开球执行前的准备阶段 -->
         <ReactiveSequence _while="!gamecontroller_isKickOffExecuted" name="wait_for_kickoff">
            <!-- 移动到球门中间位置，朝向90度（左侧） -->
            <MoveToPoseOnField x="-6.5" y="0.0" theta="1.57" 
                              long_range_threshold="100.0" 
                              turn_threshold="0.2" 
                              vx_limit="0.8" 
                              vy_limit="0.5" 
                              vtheta_limit="1.0" 
                              x_tolerance="0.3" 
                              y_tolerance="0.3" 
                              theta_tolerance="0.2" />
            <!-- 自我定位 -->
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <!-- 头部跟踪球 -->
            <CamTrackBall _while="ball_location_known" />
            <CamFindBall _while="!ball_location_known" />
            <!-- 保持静止 -->
            <SetVelocity />
         </ReactiveSequence>
         
         <!-- 开球后的守门阶段 -->
         <ReactiveSequence _while="gamecontroller_isKickOffExecuted" name="active_goalkeeping">
            <!-- 持续定位 -->
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            
            <!-- 头部始终跟踪球 -->
            <CamTrackBall _while="ball_location_known" />
            <CamFindBall _while="!ball_location_known" />
            
            <!-- 守门员的行为逻辑 -->
            <Fallback name="goalkeeper_behavior">
               <!-- 当球距离很远时，保持在球门中间位置 -->
               <Sequence name="stay_at_goal" _while="ball_range > 3.0">
                  <MoveToPoseOnField x="-6.5" y="0.0" theta="1.57" 
                                    long_range_threshold="100.0" 
                                    turn_threshold="0.2" 
                                    vx_limit="0.6" 
                                    vy_limit="0.4" 
                                    vtheta_limit="0.8" 
                                    x_tolerance="0.2" 
                                    y_tolerance="0.2" 
                                    theta_tolerance="0.15" />
               </Sequence>
               
               <!-- 当球在中等距离时，调整Y位置但保持朝向 -->
               <Sequence name="adjust_y_position" _while="ball_range <= 3.0 && ball_range > 1.5">
                  <!-- 使用Adjust动作节点进行位置调整 -->
                  <Adjust position="defense" 
                         turn_threshold="0.4" 
                         max_range="2.5" 
                         min_range="1.5" 
                         vx_limit="0.3" 
                         vy_limit="0.4" 
                         vtheta_limit="0.5" />
               </Sequence>
               
               <!-- 当球非常接近时，前进或后退拦截 -->
               <Sequence name="close_ball_reaction" _while="ball_range <= 1.5">
                  <!-- 使用Chase动作来追击球 -->
                  <Chase vx_limit="0.8" 
                        vy_limit="0.4" 
                        vtheta_limit="0.8" 
                        dist="0.8" />
               </Sequence>
               
               <!-- 默认保持位置 -->
               <SetVelocity />
            </Fallback>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root> 