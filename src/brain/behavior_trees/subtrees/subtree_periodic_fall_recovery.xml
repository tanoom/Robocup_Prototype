<root BTCPP_format="4" >
   <BehaviorTree ID="PeriodicFallRecovery">
      <Sequence name="root">
         <CheckAndStandUpPeriodic 
            check_interval_ms="50" 
            standup_timeout_ms="8000" 
            auto_relocate_after_standup="true" 
            force_relocate_always="false" />
         <ReactiveSequence _while="should_recalibrate_after_fall_recovery">
            <PrintMsg msg="Periodic Fall Recovery: Executing relocalization"/>
            <SelfLocate mode="fall_recovery" />
            <RotateForRelocate vyaw_limit="1.5" max_msec_locate="15000" />
         </ReactiveSequence>
      </Sequence>
   </BehaviorTree>
</root> 