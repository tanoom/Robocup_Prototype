<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <BehaviorTree ID="GoalKeeperPlay">
      <ReactiveSequence >
         <ReactiveSequence _while="!gamecontroller_isKickOffExecuted" name="wait">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="gamecontroller_isKickOffExecuted" name="start">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            <Sequence>
                  <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" />
                  <Sequence _while="decision == 'find'">
                     <!-- <RobotFindBall _while="ball_range <= 3.0" vyaw_limit="1.0" /> -->
                     <MoveToPoseOnField _while="ball_range > 5.0" long_range_threshold="100.0" x="-6.5" />
                  </Sequence>
                  <MoveToPoseOnField _while="decision == 'retreat' || ball_range > 5.0" long_range_threshold="100.0" x="-6.5" />
                  <Chase   _while="decision == 'chase'"  vx_limit="1.0"  vy_limit="0.4"  vtheta_limit="1.0"  dist="1.0"/>
                  <Adjust  _while="decision == 'adjust'"   position="defense" turn_threshold="0.4" max_range="0.6" min_range="0.4" vx_limit="0.2" vy_limit="0.2" vtheta_limit="1.0"  />
                  <ChaseToTarget _while="decision == 'chasetotarget'" 
                                 vx_limit="1.0" 
                                 vy_limit="0.4" 
                                 vtheta_limit="1.0" 
                                 dist="0.2" 
                                 target_x="6.5" 
                                 target_y="0.0" 
                                 turn_factor="0.6"
                                 enable_dribbling="true"
                                 dribble_distance="0.3"
                                 dribble_kick_power="1.0"
                                 dribble_kick_duration="250"
                                 dribble_cooldown="1000" />
                  <Sequence  _while="decision == 'kick'">
                     <SetVelocity />
                     <Kick vx_limit="1.2" vy_limit="0.4" min_msec_kick="300"/>
                  </Sequence>
            </Sequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
