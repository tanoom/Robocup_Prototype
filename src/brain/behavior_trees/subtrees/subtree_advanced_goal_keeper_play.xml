<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_enhanced_goal_keeper_cam_track.xml" />
   <include path="./subtree_enhanced_goal_keeper_position.xml" />
   <include path="./subtree_enhanced_goal_keeper_defense.xml" />
   <BehaviorTree ID="AdvancedGoalKeeperPlay">
      <ReactiveSequence >
         <!-- 等待开球执行前的准备阶段 -->
         <ReactiveSequence _while="!gamecontroller_isKickOffExecuted" name="wait_for_kickoff">
            <!-- 增强型头部跟踪球（支持360度搜索） -->
            <SubTree ID="EnhancedGoalKeeperCamTrack" _autoremap="true" />
            <!-- 移动到球门中间，智能选择90度或-90度朝向 -->
            <SubTree ID="EnhancedGoalKeeperPosition" _autoremap="true" />
            <!-- 自我定位 -->
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
         </ReactiveSequence>

         <!-- 开球后的三层智能防守策略 -->
         <ReactiveSequence _while="gamecontroller_isKickOffExecuted" name="intelligent_defense">
            <!-- 持续增强型头部跟踪球（支持360度搜索） -->
            <SubTree ID="EnhancedGoalKeeperCamTrack" _autoremap="true" />
            <!-- 持续自我定位 -->
            <SelfLocate mode="penalty_point_localize" _while="odom_calibrated" />
            
            <!-- 增强型三层防守策略 (支持90度和-90度朝向) -->
            <SubTree ID="EnhancedGoalKeeperDefense" _autoremap="true" />
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
