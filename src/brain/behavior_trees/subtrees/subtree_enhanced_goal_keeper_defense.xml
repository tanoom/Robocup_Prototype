<root BTCPP_format="4" >
   <BehaviorTree ID="EnhancedGoalKeeperDefense">
      <Sequence name="enhanced_defense">
         <RunOnce>
            <PrintMsg msg="Starting Enhanced Goal Keeper Defense Strategy" />
         </RunOnce>
         
         <ReactiveSequence name="adaptive_defense">
            <!-- 三层防守策略 - 适应90度和-90度朝向 -->
            <Sequence>
               <!-- 第一层：远距离防守 (球距离 > 3.0米) -->
               <IfThenElse _while="ball_range > 3.0">
                  <ScriptCondition name="Choose optimal orientation for distance defense" code="is_closer_to_forward_orientation" />
                  <Sequence name="distance_defense_90">
                     <PrintMsg msg="Distance defense at 90° orientation" />
                     <GoalKeeperPosition base_x="-6.5" base_y="0.0" base_theta="1.57"
                                        y_adjustment_factor="0.4" max_y_offset="1.0"
                                        vx_limit="0.3" vy_limit="0.3" vtheta_limit="0.5" />
                  </Sequence>
                  <Sequence name="distance_defense_minus_90">
                     <PrintMsg msg="Distance defense at -90° orientation" />
                     <GoalKeeperPosition base_x="-6.5" base_y="0.0" base_theta="-1.57"
                                        y_adjustment_factor="0.4" max_y_offset="1.0"
                                        vx_limit="0.3" vy_limit="0.3" vtheta_limit="0.5" />
                  </Sequence>
               </IfThenElse>
               
               <!-- 第二层：中距离调整 (球距离 1.5-3.0米) -->
               <IfThenElse _while="ball_range <= 3.0 && ball_range > 1.5">
                  <ScriptCondition name="Choose optimal orientation for medium defense" code="is_closer_to_forward_orientation" />
                  <Sequence name="medium_defense_90">
                     <PrintMsg msg="Medium distance Y-axis defense at 90° orientation" />
                     <GoalKeeperYAxisDefense base_x="-6.5" base_y="0.0" base_theta="1.57"
                                            prediction_distance="1.5" reaction_speed="0.4"
                                            vx_limit="0.5" vy_limit="0.3" vtheta_limit="0.8" />
                  </Sequence>
                  <Sequence name="medium_defense_minus_90">
                     <PrintMsg msg="Medium distance Y-axis defense at -90° orientation" />
                     <GoalKeeperYAxisDefense base_x="-6.5" base_y="0.0" base_theta="-1.57"
                                            prediction_distance="1.5" reaction_speed="0.4"
                                            vx_limit="0.5" vy_limit="0.3" vtheta_limit="0.8" />
                  </Sequence>
               </IfThenElse>
               
               <!-- 第三层：近距离拦截 (球距离 <= 1.5米) -->
               <Sequence name="close_range_chase" _while="ball_range <= 1.5">
                  <PrintMsg msg="Ball is close - executing aggressive chase to tackle ball" />
                  <Chase vx_limit="1.0" vy_limit="1.0" vtheta_limit="1.2" dist="0.1" />
               </Sequence>
            </Sequence>
         </ReactiveSequence>
         
         <PrintMsg msg="Enhanced Goal Keeper Defense Strategy completed" />
      </Sequence>
   </BehaviorTree>
</root> 